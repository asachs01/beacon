{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", {
      "changelogFile": "CHANGELOG.md"
    }],
    ["@semantic-release/exec", {
      "prepareCmd": "bash scripts/prepare-addon-release.sh \"${nextRelease.version}\""
    }],
    ["@semantic-release/git", {
      "assets": ["CHANGELOG.md", "beacon/CHANGELOG.md", "beacon/config.yaml", "package.json"],
      "message": "release: ${nextRelease.version}\n\n${nextRelease.notes}\n\nCo-Authored-By: claude-flow <ruv@ruv.net>"
    }],
    "@semantic-release/github"
  ]
}
