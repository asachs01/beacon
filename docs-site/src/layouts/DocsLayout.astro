---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Sidebar from '@/components/Sidebar.astro';
import Feedback from '@/components/Feedback.astro';
import FAQSchema from '@/components/FAQSchema.astro';
import type { FAQItem } from '@/components/FAQSchema.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  faq?: FAQItem[];
  /** Repo path on main, for example docs-site/src/content/docs/features/calendar.mdx */
  editPath?: string;
}

const { title, description, ogImage, faq, editPath } = Astro.props;
const pagePath = Astro.url.pathname;
const editBase = String(import.meta.env.GITHUB_EDIT_BASE || 'https://github.com/asachs01/beacon/edit/main/');
const editUrl = editPath
  ? `${editBase.endsWith('/') ? editBase : `${editBase}/`}${editPath.replace(/^\//, '')}`
  : undefined;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <Header />
  <div class="container flex-1 flex">
    <Sidebar />
    <main class="flex-1 min-w-0 py-8 lg:pl-8 lg:border-l lg:border-[var(--td-border)]">
      {faq && faq.length > 0 && <FAQSchema items={faq} />}
      <article class="prose">
        {editUrl && (
          <p class="not-prose mb-6 text-right">
            <a
              href={editUrl}
              class="text-sm text-[var(--td-text-muted)] hover:text-[var(--td-accent)]"
            >
              Edit this page on GitHub
            </a>
          </p>
        )}
        <slot />
      </article>
      <Feedback pageTitle={title} pagePath={pagePath} />
    </main>
  </div>
  <Footer />
  <script>
    // Clone sidebar nav into mobile menu
    const desktopSidebar = document.querySelector('.sidebar-nav');
    const mobileNav = document.getElementById('mobile-sidebar-content');
    if (desktopSidebar && mobileNav) {
      mobileNav.innerHTML = desktopSidebar.innerHTML;
    }
  </script>
</BaseLayout>
