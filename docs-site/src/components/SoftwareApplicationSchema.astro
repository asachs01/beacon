---
import { absoluteUrl } from "../../site.config.mjs";

/**
 * SoftwareApplication JSON-LD for the docs homepage.
 * Keep claims factual: Beacon is free, MIT-licensed, and runs in a browser or as a signed Android APK (sideload; not on Play Store yet).
 */
const site = absoluteUrl("/");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Beacon",
  description:
    "A free, MIT-licensed family command center that installs as a Home Assistant add-on and runs in any tablet's browser or as a signed Android app.",
  url: site,
  image: absoluteUrl("/og-image.png"),
  applicationCategory: "LifestyleApplication",
  operatingSystem: "Android, any device with a modern web browser",
  license: "https://opensource.org/licenses/MIT",
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  codeRepository: "https://github.com/asachs01/beacon",
  softwareHelp: site,
};

const json = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<script type="application/ld+json" set:html={json} />
