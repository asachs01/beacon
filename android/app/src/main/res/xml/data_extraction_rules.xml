<?xml version="1.0" encoding="utf-8"?>
<!--
  Backups on Android 12 and later (backup_rules.xml has the same for older
  versions). The Home Assistant login stays on this device: the secure
  storage plugin's copy is encrypted with a Keystore key that isn't backed
  up, and CapacitorStorage is where earlier builds kept it unencrypted.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
